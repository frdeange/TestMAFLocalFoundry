# Azure AI Foundry configuration
FOUNDRY_PROJECT_ENDPOINT="https://<your-project>.services.ai.azure.com/api/projects/<your-project-name>"
FOUNDRY_MODEL="gpt-4o-mini"

# Observability behavior
ENABLE_SENSITIVE_DATA=true
ENABLE_LIVE_METRICS=true

# Optional OpenTelemetry exporter endpoint (local backends such as Aspire/Jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# OTEL_SERVICE_NAME="test-maf-local-foundry"
